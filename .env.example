# Copy to .env and fill locally. NEVER commit real values.
# Backend-only values must never use the VITE_ prefix.

# --- API (backend only) ---
NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Per-IP request limit across all routes, per window (ms)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Largest accepted request body in bytes
BODY_LIMIT_BYTES=65536

# Neon pooled connection (runtime) and direct connection (migrations). See docs/database-provider-switch.md
DATABASE_URL=
DIRECT_URL=
# Owner sign-in (#19). 32 random bytes, base64: `openssl rand -base64 32`. Backend only, never VITE_*.
AUTH_SECRET_KEY=
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Get Help (#22): submissions per IP per hour, and the same-phone duplicate window in minutes.
# OWNER_NOTIFICATION_EMAIL above: when set, each new request queues an owner notification.
HELP_RATE_LIMIT_PER_HOUR=5
HELP_DUPLICATE_WINDOW_MINUTES=10
# Public content (#21): browser/CDN cache seconds, and the public base URL of approved documents
PUBLIC_CACHE_SECONDS=300
PUBLIC_DOCUMENTS_BASE_URL=
# Public site origin for acknowledgement links and the PDF verification QR (#29). Default: first CORS origin.
PUBLIC_SITE_URL=
# Acknowledgement page + PDF requests per IP per hour.
RECEIPT_RATE_LIMIT_PER_HOUR=60
# Email (#30): resend | brevo | none. With none, emails stay queued and nothing is sent.
EMAIL_PROVIDER=none
# Provider API key — API only, never VITE_*.
EMAIL_API_KEY=
# Verified sender, e.g. Theonetrust.in <no-reply@theonetrust.in> [CONFIRM domain]
EMAIL_FROM=
EMAIL_WORKER_INTERVAL_MS=30000
# Database test suite only: a LOCAL empty PostgreSQL (the suite drops its schema)
TEST_DATABASE_URL=

# Razorpay (test keys only until launch issue #39)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Donation intents per IP per hour (#23)
DONATION_RATE_LIMIT_PER_HOUR=20

# Where owner emails go (new donations, new help requests). Unset = owner emails are not sent.
OWNER_NOTIFICATION_EMAIL=

# --- Web (public, bundled into the browser) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
# Preview/review builds only: show unconfirmed landing content marked "Draft". Never true in production.
VITE_SHOW_DRAFT_CONTENT=false
# 'api' on the live site: landing content comes from the public API (#21). 'bundled' = shipped content only.
VITE_CONTENT_SOURCE=bundled
# Get Help adapter: api (live, once the API is deployed — #22), mock (dev/e2e only, never live) or unavailable
VITE_HELP_ADAPTER=unavailable
# Donate panel adapter: api (live, once payments are on — #24/#26), mock (dev/e2e only, never live) or unavailable
VITE_DONATE_ADAPTER=unavailable
