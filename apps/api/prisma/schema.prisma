// Theonetrust.in — PostgreSQL schema (Prisma ORM 7, pinned).
// Portable: standard PostgreSQL types, constraints and indexes only — no Neon- or
// Supabase-specific features. Amounts are integer paise. IDs are UUIDs; public links use
// separate unguessable references or token hashes, never these IDs.
// Extra CHECK constraints live in the migration SQL (Prisma cannot express them).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ── Enums (mirror packages/contracts/src/statuses.ts) ───────────────────────────────────

enum AdminRole {
  OWNER
  STAFF
}

enum FundDesignation {
  GENERAL
  RESTRICTED
}

enum DonationStatus {
  CREATED
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
  MANUAL_REVIEW
}

enum PaymentProvider {
  RAZORPAY
  BANK_TRANSFER
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum TaxCertificateStatus {
  NOT_APPLICABLE
  PENDING_TRUST_FILING
  FORM_113_FILED
  FORM_114_ISSUED
  CORRECTION_REQUIRED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum Locale {
  ta
  en
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HelpRequestStatus {
  NEW
  CONTACTED
  VERIFYING
  HELPING
  CLOSED
}

enum HelpRequestKind {
  FULL
  CALLBACK
}

enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PAUSED
  HALTED
  CANCELLED
  COMPLETED
}

enum BankTransferStatus {
  REPORTED
  MATCHED
  REJECTED
}

enum DonationChannel {
  CHECKOUT
  BANK_TRANSFER
}

enum PaymentExceptionKind {
  UNMATCHED_CREDIT
  AMOUNT_MISMATCH
  ALREADY_PAID
  /// Provider data disagrees with our order (amount, currency or order ID) — #26.
  PAYMENT_MISMATCH
  /// A second payment arrived for an order that already has one — #26.
  DUPLICATE_PAYMENT
}

enum ExceptionStatus {
  OPEN
  RESOLVED
}

// ── Admin ───────────────────────────────────────────────────────────────────────────────

model AdminUser {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String    @unique
  passwordHash         String?   @map("password_hash")
  authProvider         String?   @map("auth_provider")
  authSubject          String?   @map("auth_subject")
  role                 AdminRole @default(STAFF)
  active               Boolean   @default(true)
  lastLoginAt          DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// Authenticator-app secret, AES-256-GCM encrypted with AUTH_ENCRYPTION_KEY (never plain).
  totpSecretCiphertext Bytes?    @map("totp_secret_ciphertext")
  totpKeyVersion       Int?      @map("totp_key_version")
  totpEnabledAt        DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// Last accepted 30-second time step: a code can never be used twice.
  totpLastStep         BigInt?   @map("totp_last_step")
  failedLoginCount     Int       @default(0) @map("failed_login_count")
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz(3)
  locale               Locale    @default(en)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  auditLogs        AuditLog[]
  sessions         AdminSession[]
  recoveryCodes    AdminRecoveryCode[]
  helpNotes        HelpRequestNote[]
  assignedRequests HelpRequest[]
  bankTransfers    BankTransferRecord[]
  bankCredits      BankTransferRecord[] @relation("BankCreditRecordedBy")

  @@unique([authProvider, authSubject])
  @@map("admin_users")
}

/// Server-side admin session. The cookie holds a random token; only its SHA-256 is stored.
model AdminSession {
  id            String    @id @default(uuid()) @db.Uuid
  adminUserId   String    @map("admin_user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  /// Null until the second factor is verified. Admin routes require it.
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// One-time recovery codes for a lost authenticator. Only hashes are stored.
model AdminRecoveryCode {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  codeHash    String    @unique @map("code_hash")
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_recovery_codes")
}

// ── Programmes and donations ────────────────────────────────────────────────────────────

model Programme {
  id            String          @id @default(uuid()) @db.Uuid
  slug          String          @unique
  titleTa       String          @map("title_ta")
  titleEn       String          @map("title_en")
  descriptionTa String?         @map("description_ta")
  descriptionEn String?         @map("description_en")
  designation   FundDesignation @default(GENERAL)
  active        Boolean         @default(false)
  sortOrder     Int             @default(0) @map("sort_order")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  donationIntents DonationIntent[]
  subscriptions   DonationSubscription[]

  @@index([active, sortOrder])
  @@map("programmes")
}

/// One donation the donor started. Only server-verified captured payments make it PAID.
model DonationIntent {
  id                  String          @id @default(uuid()) @db.Uuid
  /// Unguessable public reference shown to the donor; never the UUID.
  publicReference     String          @unique @map("public_reference")
  programmeId         String?         @map("programme_id") @db.Uuid
  /// What the payment provider is asked to collect: giftPaise + feePaise. Server-computed only.
  amountPaise         Int             @map("amount_paise")
  /// The donation itself, as chosen by the donor.
  giftPaise           Int             @map("gift_paise")
  /// Optional fee cover the donor chose to add (0 when not chosen). Estimate from the fee table.
  feePaise            Int             @default(0) @map("fee_paise")
  currency            String          @default("INR") @db.Char(3)
  status              DonationStatus  @default(CREATED)
  /// First time the donation reached PAID (verified). Null until then; never cleared.
  paidAt              DateTime?       @map("paid_at") @db.Timestamptz(3)
  /// How the donor pays: Razorpay Checkout, or bank transfer confirmed by the owner (#25).
  channel             DonationChannel @default(CHECKOUT)
  /// Browser-supplied key so a double click or retry never creates a second order.
  idempotencyKey      String?         @unique @map("idempotency_key")
  consentAt           DateTime?       @map("consent_at") @db.Timestamptz(3)
  donorName           String          @map("donor_name")
  donorEmail          String?         @map("donor_email")
  donorPhone          String?         @map("donor_phone")
  hideNamePublicly    Boolean         @default(true) @map("hide_name_publicly")
  wantsReceipt        Boolean         @default(false) @map("wants_receipt")
  wantsTaxCertificate Boolean         @default(false) @map("wants_tax_certificate")
  coverFee            Boolean         @default(false) @map("cover_fee")
  locale              Locale          @default(en)
  subscriptionId      String?         @map("subscription_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  programme       Programme?              @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  subscription    DonationSubscription?   @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  paymentAttempts PaymentAttempt[]
  receipts        Receipt[]
  donorIdentity   DonorIdentityRecord?
  taxTracking     TaxCertificateTracking?
  bankTransfers   BankTransferRecord[]
  bankClaims      BankTransferClaim[]
  exceptions      PaymentException[]
  statusEvents    DonationStatusEvent[]
  webhookEvents   WebhookEvent[]

  @@index([status, createdAt])
  @@index([programmeId, createdAt])
  @@index([createdAt])
  @@map("donation_intents")
}

/// One provider order/payment for an intent. Provider IDs are unique across the ledger.
/// Every status change of a donation, written by the transition service (#31). Append-only.
model DonationStatusEvent {
  id               String         @id @default(uuid()) @db.Uuid
  donationIntentId String         @map("donation_intent_id") @db.Uuid
  fromStatus       DonationStatus @map("from_status")
  toStatus         DonationStatus @map("to_status")
  /// gateway_verified | owner_bank_evidence | gateway_status | owner_review | donor_report
  source           String
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  donationIntent DonationIntent @relation(fields: [donationIntentId], references: [id], onDelete: Restrict)

  @@index([donationIntentId, createdAt])
  @@map("donation_status_events")
}

model PaymentAttempt {
  id                  String          @id @default(uuid()) @db.Uuid
  donationIntentId    String          @map("donation_intent_id") @db.Uuid
  provider            PaymentProvider @default(RAZORPAY)
  providerOrderId     String          @unique @map("provider_order_id")
  providerPaymentId   String?         @unique @map("provider_payment_id")
  providerStatus      String?         @map("provider_status")
  amountPaise         Int             @map("amount_paise")
  method              String?
  capturedPaise       Int             @default(0) @map("captured_paise")
  refundedPaise       Int             @default(0) @map("refunded_paise")
  feePaise            Int?            @map("fee_paise")
  signatureVerifiedAt DateTime?       @map("signature_verified_at") @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  donationIntent DonationIntent @relation(fields: [donationIntentId], references: [id], onDelete: Restrict)
  receipt        Receipt?

  @@index([donationIntentId])
  @@map("payment_attempts")
}

/// Every provider webhook, deduplicated by event ID. No secrets or signatures stored.
model WebhookEvent {
  id               String                  @id @default(uuid()) @db.Uuid
  provider         PaymentProvider         @default(RAZORPAY)
  providerEventId  String                  @map("provider_event_id")
  eventType        String                  @map("event_type")
  signatureValid   Boolean                 @map("signature_valid")
  processingStatus WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  /// Short error code only — never the payload or a stack trace.
  processingError  String?                 @map("processing_error")
  attempts         Int                     @default(0)
  receivedAt       DateTime                @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt      DateTime?               @map("processed_at") @db.Timestamptz(3)
  /// The donation this event was applied to (#31 webhook history); null if none matched.
  donationIntentId String?                 @map("donation_intent_id") @db.Uuid

  donationIntent DonationIntent? @relation(fields: [donationIntentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([donationIntentId])
  @@index([processingStatus, receivedAt])
  @@map("webhook_events")
}

model DonationSubscription {
  id                     String             @id @default(uuid()) @db.Uuid
  /// Unguessable public reference shown to the donor (TOT-M-…); never the UUID.
  publicReference        String             @unique @map("public_reference")
  providerSubscriptionId String             @unique @map("provider_subscription_id")
  providerPlanId         String?            @map("provider_plan_id")
  programmeId            String?            @map("programme_id") @db.Uuid
  amountPaise            Int                @map("amount_paise")
  interval               String             @default("monthly")
  /// upi_autopay (≤ ₹15,000/month) or emandate_card (above) — routed by amount (#32).
  methodRoute            String             @map("method_route")
  status                 SubscriptionStatus @default(CREATED)
  donorName              String             @map("donor_name")
  donorEmail             String?            @map("donor_email")
  donorPhone             String?            @map("donor_phone")
  /// Random salt; the manage token is HMAC(key, salt) and is never stored.
  manageTokenSalt        String             @map("manage_token_salt")
  /// SHA-256 of the manage-link token; the token itself is never stored.
  manageTokenHash        String             @unique @map("manage_token_hash")
  /// Browser-supplied key so a double click or retry never creates a second subscription.
  idempotencyKey         String?            @unique @map("idempotency_key")
  /// The donor ticked the mandate consent shown with amount, frequency, start date and how to cancel.
  consentAt              DateTime           @map("consent_at") @db.Timestamptz(3)
  consentVersion         String             @map("consent_version")
  /// First charge date (IST); never on the 29th–31st so every month has the day.
  startAt                DateTime?          @map("start_at") @db.Timestamptz(3)
  locale                 Locale             @default(en)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledAt            DateTime?          @map("cancelled_at") @db.Timestamptz(3)

  programme Programme?       @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  charges   DonationIntent[]

  @@index([status])
  @@map("donation_subscriptions")
}

/// One Razorpay plan per fixed monthly amount, created once and reused (#32).
model SubscriptionPlan {
  id             String          @id @default(uuid()) @db.Uuid
  provider       PaymentProvider @default(RAZORPAY)
  providerPlanId String          @unique @map("provider_plan_id")
  amountPaise    Int             @map("amount_paise")
  period         String          @default("monthly")
  interval       Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([provider, amountPaise, period, interval])
  @@map("subscription_plans")
}

/// Private identity for tax opt-in. PAN is stored only encrypted (app-level, key outside the DB).
model DonorIdentityRecord {
  id               String   @id @default(uuid()) @db.Uuid
  donationIntentId String   @unique @map("donation_intent_id") @db.Uuid
  fullName         String   @map("full_name")
  addressLine      String?  @map("address_line")
  panCiphertext    Bytes?   @map("pan_ciphertext")
  panKeyVersion    Int?     @map("pan_key_version")
  /// Last four characters for display to the owner (e.g. "**** 234F").
  panLast4         String?  @map("pan_last4") @db.VarChar(4)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  donationIntent DonationIntent @relation(fields: [donationIntentId], references: [id], onDelete: Restrict)

  @@map("donor_identity_records")
}

/// A bank credit the OWNER recorded from the trust's bank statement (#25). Only an owner with
/// this evidence, a second confirmation and a reason can turn it into a paid donation.
model BankTransferRecord {
  id               String             @id @default(uuid()) @db.Uuid
  donationIntentId String?            @map("donation_intent_id") @db.Uuid
  /// UTR / bank reference as printed on the statement.
  bankReference    String             @unique @map("bank_reference")
  amountPaise      Int                @map("amount_paise")
  receivedOn       DateTime           @map("received_on") @db.Date
  /// Where the owner saw it, e.g. "SBI statement 03-11-2026, line 14". No account numbers.
  evidence         String
  status           BankTransferStatus @default(REPORTED)
  recordedById     String             @map("recorded_by_id") @db.Uuid
  matchedById      String?            @map("matched_by_id") @db.Uuid
  matchedAt        DateTime?          @map("matched_at") @db.Timestamptz(3)
  decisionReason   String?            @map("decision_reason")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  donationIntent DonationIntent?    @relation(fields: [donationIntentId], references: [id], onDelete: Restrict)
  recordedBy     AdminUser          @relation("BankCreditRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  matchedBy      AdminUser?         @relation(fields: [matchedById], references: [id], onDelete: Restrict)
  exceptions     PaymentException[]
  receipt        Receipt?

  @@index([status])
  @@map("bank_transfer_records")
}

/// What a donor says they paid (optional UTR). Never proof of payment — it only helps matching.
model BankTransferClaim {
  id               String   @id @default(uuid()) @db.Uuid
  donationIntentId String   @map("donation_intent_id") @db.Uuid
  utr              String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  donationIntent DonationIntent @relation(fields: [donationIntentId], references: [id], onDelete: Restrict)

  @@index([utr])
  @@index([donationIntentId])
  @@map("bank_transfer_claims")
}

/// Something the owner must look at: unmatched credit, amount mismatch, already paid (#25, #31).
model PaymentException {
  id                   String               @id @default(uuid()) @db.Uuid
  kind                 PaymentExceptionKind
  status               ExceptionStatus      @default(OPEN)
  donationIntentId     String?              @map("donation_intent_id") @db.Uuid
  bankTransferRecordId String?              @map("bank_transfer_record_id") @db.Uuid
  /// Provider payment ID involved (no card or UPI details).
  providerPaymentId    String?              @map("provider_payment_id")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt           DateTime?            @map("resolved_at") @db.Timestamptz(3)
  resolvedById         String?              @map("resolved_by_id") @db.Uuid
  resolution           String?

  donationIntent     DonationIntent?     @relation(fields: [donationIntentId], references: [id], onDelete: Restrict)
  bankTransferRecord BankTransferRecord? @relation(fields: [bankTransferRecordId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("payment_exceptions")
}

// ── Receipts and tax ────────────────────────────────────────────────────────────────────

/// "Donation acknowledgement" — never Form 114. One receipt per payment; corrections add rows.
model Receipt {
  id                   String    @id @default(uuid()) @db.Uuid
  donationIntentId     String    @map("donation_intent_id") @db.Uuid
  /// The verified payment this acknowledges. Set on the ORIGINAL receipt only (unique: one per
  /// payment, even across retries); a correction points at the receipt it replaces instead.
  paymentAttemptId     String?   @unique @map("payment_attempt_id") @db.Uuid
  /// Same, for a bank transfer the owner confirmed (#25).
  bankTransferRecordId String?   @unique @map("bank_transfer_record_id") @db.Uuid
  /// TOT-R-<financial year>-<sequence>, server-assigned once.
  receiptNumber        String    @unique @map("receipt_number")
  /// Amount acknowledged (integer paise) — the verified amount, or the net after a partial refund.
  amountPaise          Int       @map("amount_paise")
  templateVersion      String    @map("template_version")
  /// Random per-receipt salt; the share token is HMAC(receipt key, salt) and is never stored.
  tokenSalt            String    @map("token_salt")
  /// SHA-256 of the share-link token; the token itself is never stored.
  tokenHash            String?   @unique @map("token_hash")
  storageKey           String?   @map("storage_key")
  issuedAt             DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  replacesId           String?   @unique @map("replaces_id") @db.Uuid
  voidedAt             DateTime? @map("voided_at") @db.Timestamptz(3)
  /// REFUNDED (donation refunded in full) or CORRECTED (replaced by a newer receipt).
  voidReason           String?   @map("void_reason")

  donationIntent     DonationIntent      @relation(fields: [donationIntentId], references: [id], onDelete: Restrict)
  paymentAttempt     PaymentAttempt?     @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  bankTransferRecord BankTransferRecord? @relation(fields: [bankTransferRecordId], references: [id], onDelete: Restrict)
  replaces           Receipt?            @relation("ReceiptCorrection", fields: [replacesId], references: [id], onDelete: Restrict)
  replacedBy         Receipt?            @relation("ReceiptCorrection")

  @@index([donationIntentId])
  @@map("receipts")
}

/// Statutory certificate tracking (feature-gated). Never marked issued without evidence.
model TaxCertificateTracking {
  id               String               @id @default(uuid()) @db.Uuid
  donationIntentId String               @unique @map("donation_intent_id") @db.Uuid
  /// Financial year label, e.g. "2026-27" (April–March, IST).
  financialYear    String               @map("financial_year") @db.VarChar(7)
  status           TaxCertificateStatus @default(PENDING_TRUST_FILING)
  form113Reference String?              @map("form_113_reference")
  form113FiledAt   DateTime?            @map("form_113_filed_at") @db.Timestamptz(3)
  form114Reference String?              @map("form_114_reference")
  form114IssuedOn  DateTime?            @map("form_114_issued_on") @db.Date
  notes            String?
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  donationIntent DonationIntent @relation(fields: [donationIntentId], references: [id], onDelete: Restrict)

  @@index([financialYear, status])
  @@map("tax_certificate_tracking")
}

// ── Notifications ───────────────────────────────────────────────────────────────────────

/// Retryable outbox. Stores a reference to look data up, not the sensitive payload.
model NotificationOutbox {
  id            String             @id @default(uuid()) @db.Uuid
  eventType     String             @map("event_type")
  /// e.g. "donation_intent:<uuid>" — the worker looks the details up.
  entityRef     String             @map("entity_ref")
  template      String
  locale        Locale             @default(en)
  status        NotificationStatus @default(PENDING)
  retryCount    Int                @default(0) @map("retry_count")
  nextAttemptAt DateTime           @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  sentAt        DateTime?          @map("sent_at") @db.Timestamptz(3)
  failedAt      DateTime?          @map("failed_at") @db.Timestamptz(3)
  lastError     String?            @map("last_error")
  dedupeKey     String             @unique @map("dedupe_key")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

// ── Content ─────────────────────────────────────────────────────────────────────────────

model ContentSection {
  id         String            @id @default(uuid()) @db.Uuid
  sectionKey String            @map("section_key")
  locale     Locale
  /// Structured, validated by the API before saving.
  content    Json
  status     PublicationStatus @default(DRAFT)
  version    Int               @default(1)
  editedById String?           @map("edited_by_id") @db.Uuid
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([sectionKey, locale, version])
  @@index([sectionKey, locale, status])
  @@map("content_sections")
}

/// Published only with a source, a period and an "as of" date, plus owner approval — never invented.
model ImpactMetric {
  id           String            @id @default(uuid()) @db.Uuid
  labelTa      String            @map("label_ta")
  labelEn      String            @map("label_en")
  value        BigInt
  valueFormat  String            @default("count") @map("value_format")
  /// Where the figure comes from, e.g. "Trust accounts 2025-26 (audited)".
  sourceTa     String?           @map("source_ta")
  sourceEn     String?           @map("source_en")
  /// The period it covers, e.g. "April 2025 – March 2026".
  periodTa     String?           @map("period_ta")
  periodEn     String?           @map("period_en")
  /// The date the figure is correct as of.
  asOf         DateTime?         @map("as_of") @db.Date
  evidenceUrl  String?           @map("evidence_url")
  status       PublicationStatus @default(DRAFT)
  approvedById String?           @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?         @map("approved_at") @db.Timestamptz(3)
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, sortOrder])
  @@map("impact_metrics")
}

model TransparencyDocument {
  id           String            @id @default(uuid()) @db.Uuid
  title        String
  locale       Locale
  periodLabel  String?           @map("period_label")
  storageKey   String            @unique @map("storage_key")
  fileType     String            @map("file_type")
  fileSize     Int               @map("file_size")
  status       PublicationStatus @default(DRAFT)
  approvedById String?           @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?         @map("approved_at") @db.Timestamptz(3)
  uploadedAt   DateTime          @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  @@index([status, locale])
  @@map("transparency_documents")
}

/// Singleton row (id = 1). Tax benefit stays off until the CA confirms approval.
model TrustSettings {
  id                 Int       @id @default(1)
  taxBenefitEnabled  Boolean   @default(false) @map("tax_benefit_enabled")
  rnpoReference      String?   @map("rnpo_reference")
  section354Approval String?   @map("section_354_approval")
  approvalValidUntil DateTime? @map("approval_valid_until") @db.Date
  receiptMinPaise    Int       @default(50000) @map("receipt_min_paise")
  /// Trust legal name and registration line printed on acknowledgements [CONFIRM] #1. Null =
  /// not confirmed yet: the acknowledgement shows the site name and no registration line.
  legalName          String?   @map("legal_name")
  registrationText   String?   @map("registration_text")
  /// Largest single online donation accepted [CONFIRM with the trust]; larger gifts use bank transfer (#25).
  maxDonationPaise   Int       @default(50000000) @map("max_donation_paise")
  /// Fee table for the optional "cover the fee" estimate (see modules/donations/fees.ts).
  /// Null = fee cover is not offered (the default until the trust confirms its pricing).
  feeTable           Json?     @map("fee_table")
  /// Trust bank account for NEFT/RTGS/IMPS [CONFIRM]. All null = bank transfer not offered.
  bankAccountName    String?   @map("bank_account_name")
  bankAccountNumber  String?   @map("bank_account_number")
  bankIfsc           String?   @map("bank_ifsc") @db.Char(11)
  bankName           String?   @map("bank_name")
  foreignDonations   Boolean   @default(false) @map("foreign_donations")
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("trust_settings")
}

// ── Help requests ───────────────────────────────────────────────────────────────────────

model HelpRequest {
  id                  String            @id @default(uuid()) @db.Uuid
  /// Public reference the person can quote on the phone, e.g. "HLP-7K2M9Q". No personal data.
  reference           String            @unique
  kind                HelpRequestKind   @default(FULL)
  status              HelpRequestStatus @default(NEW)
  /// self | someone | on_behalf (packages/contracts HELP_FOR). Null for call-back requests.
  forWhom             String?           @map("for_whom")
  /// One or more of packages/contracts HELP_KINDS.
  helpTypes           String[]          @map("help_types")
  description         String?
  /// E.164 (+91XXXXXXXXXX). Needed to call back; masked in every export.
  contactPhone        String            @map("contact_phone")
  /// Language the person wants to be called in.
  locale              Locale            @default(ta)
  /// Language of the page they used.
  pageLocale          Locale            @default(ta) @map("page_locale")
  bestTime            String?           @map("best_time")
  /// Only when asking for someone else, and only if they were comfortable sharing it.
  personNameOrVillage String?           @map("person_name_or_village")
  consentAt           DateTime          @map("consent_at") @db.Timestamptz(3)
  thirdPartyConsentAt DateTime?         @map("third_party_consent_at") @db.Timestamptz(3)
  assigneeId          String?           @map("assignee_id") @db.Uuid
  remindOn            DateTime?         @map("remind_on") @db.Date
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignee AdminUser?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  notes    HelpRequestNote[]

  @@index([status, createdAt])
  @@index([locale, createdAt])
  @@index([contactPhone, createdAt])
  @@map("help_requests")
}

model HelpRequestNote {
  id            String   @id @default(uuid()) @db.Uuid
  helpRequestId String   @map("help_request_id") @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  body          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  helpRequest HelpRequest @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)
  author      AdminUser   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([helpRequestId, createdAt])
  @@map("help_request_notes")
}

// ── Audit ───────────────────────────────────────────────────────────────────────────────

/// Append-only (enforced by a trigger in the migration). Changed field NAMES only, no values.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  reason        String?
  changedFields String[] @map("changed_fields")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
